# ==============================================================================
# FinPaluse — Environment Configuration Template (.env.example)
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate-a-secure-random-64-character-secret-key

# ── Supabase Database (PostgreSQL IPv4 Pooler) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL_SYNC=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ── Supabase Auth ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── AI / LLM Providers ────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Frontend Public Variables ────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
